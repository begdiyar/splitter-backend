# Environment variables for splitter-backend

# Server
PORT=3001

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Database URL (set by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Receipt parsing (optional). Gemini is used first; OpenAI only when GEMINI_API_KEY is empty.
# Without any key the server returns mock receipt items.
GEMINI_API_KEY=
OPENAI_API_KEY=
